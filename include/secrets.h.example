#pragma once

// --- WiFi ---
#define SECRET_STA_SSID        "YOUR_WIFI_SSID"
#define SECRET_STA_PASS        "YOUR_WIFI_PASSWORD"

// --- OTA (ArduinoOTA) ---
#define SECRET_OTA_PASSWORD    "CHANGE_ME_OTA"

// --- Dashboard web (HTTP Basic Auth) ---
#define SECRET_WEB_USER        "admin"
#define SECRET_WEB_PASS        "CHANGE_ME_WEB"

